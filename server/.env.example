# Copy to .env and adjust.
PORT=4000

# Docker MySQL from docker-compose.yml listens on 3307; a local install usually on 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=rms
# Least-privilege account created by db/04_app_user.sql
DB_USER=rms_app
DB_PASSWORD=rms_app_pass

# Any long random string; used to sign login tokens.
JWT_SECRET=replace-with-a-long-random-string
